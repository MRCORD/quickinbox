# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit it.
#
# In production these live as Worker secrets / vars instead.

# resend (default) or cloudflare. Set in wrangler.jsonc vars for production;
# uncomment here only to override locally.
# EMAIL_PROVIDER=resend

# --- Resend (EMAIL_PROVIDER=resend) ---
# From https://resend.com/api-keys — needs full access (send + domains + receiving).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown once when you create the webhook at https://resend.com/webhooks
# (see the README). Starts with whsec_.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare Email (EMAIL_PROVIDER=cloudflare) ---
# Comma-separated domains already onboarded in Email Service / Email Routing.
# CLOUDFLARE_MAIL_DOMAINS=example.com,mail.example.com

# --- Telegram notifications (optional) ---
# Ping a Telegram chat on every inbound message. Both values are required —
# leave either blank and notifications stay off. Works with both providers.
# Token from @BotFather; chat id from @userinfobot (negative for groups).
# Production values should be added with `wrangler secret put`, not committed.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=987654321
# Forum supergroups only: the topic to post into. Without it Telegram puts the
# message in General. Open the topic and read the last number in its link.
# TELEGRAM_THREAD_ID=3
# Public URL of this install, linked from each notification.
# APP_URL=https://mail.example.com

# --- Desktop notifications (optional) ---
# Generate once with: bunx web-push generate-vapid-keys
# Production values should be added with `wrangler secret put`, not committed.
# VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:admin@example.com

# --- Inbox tabs (optional) ---
# TypeSafe classifies inbound mail into Primary, Social, Promotions, Updates,
# Forums, and spam. Keep the placeholder to skip — everything stays in Primary.
# Production: wrangler secret put TYPESAFE_API_KEY
TYPESAFE_API_KEY=REPLACE_WITH_YOUR_TYPESAFE_API_KEY

# --- Sign in with Clerk (optional) ---
# Leave AUTH_MODE unset to keep email + password. See "Sign in with Clerk" in
# the README. Use a Clerk *development* instance locally; production keys do
# not work on localhost.
# AUTH_MODE=clerk
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Instance PEM public key; keep the newlines as literal \n in one line.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional: lets the admin invite also email a Clerk invitation (sk_test_... locally).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# ADMIN_EMAILS=you@example.com
# Others allowed to be created on first sign-in: emails, @domain suffixes, or *.
# Unset = only the first user and ADMIN_EMAILS.
# ALLOWED_EMAILS=@example.com
# Signing secret of the Clerk webhook at /api/webhooks/clerk (user.updated, user.deleted).
# CLERK_WEBHOOK_SECRET=whsec_...
